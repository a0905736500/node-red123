            ]
        ]
    },
    {
        "id": "dc1490f77c550408",
        "type": "function",
        "z": "2889e6814487a261",
        "name": "解析各組溫濕度給 UI",
        "func": "let parts = msg.topic.split('/');\nlet groupName = parts[1] || 'unknown';\nlet data = msg.payload;\n\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch (e) { data = parseFloat(data); }\n}\n\nlet tempMsg = null;\nlet humMsg = null;\n\n// 判斷溫度 (相容中英文欄位與 Topic)\nif (msg.topic.includes('溫度') || msg.topic.includes('temp') || (typeof data === 'object' && (data['溫度'] !== undefined || data.temperature !== undefined))) {\n    let val = typeof data === 'object' ? (data['溫度'] ?? data.temperature) : data;\n    if (!isNaN(val)) {\n        tempMsg = { payload: Number(val), topic: groupName };\n    }\n}\n\n// 判斷濕度 (相容中英文欄位與 Topic)\nif (msg.topic.includes('濕度') || msg.topic.includes('hum') || (typeof data === 'object' && (data['濕度'] !== undefined || data.humidity !== undefined))) {\n    let val = typeof data === 'object' ? (data['濕度'] ?? data.humidity) : data;\n    if (!isNaN(val)) {\n        humMsg = { payload: Number(val), topic: groupName };\n    }\n}\n\nreturn [tempMsg, humMsg];",
        "outputs": 2,
        "noerr": 0,
        "x": 450,
        "y": 280,
        "wires": [
            [
                "7a8754fd7da8c384",
                "1156481a708a7b7f"
            ],
            [
                "5b998f815bcb742c",
                "661a37e1af75f0bd"
            ]
        ]
    },
