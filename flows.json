    },
    {
        "id": "650045b8f528b82c",
        "type": "function",
        "z": "2889e6814487a261",
        "name": "產生隨機溫濕度",
        "func": "// 產生 22.0 ~ 28.0 之間的隨機溫度\nconst tempMsg = {\n    topic: \"AIOT/user14/溫度\",\n    payload: {\n        \"溫度\": Number((Math.random() * 6 + 22).toFixed(1))\n    }\n};\n\n// 產生 50 ~ 75 之間的隨機濕度\nconst humMsg = {\n    topic: \"AIOT/user14/濕度\",\n    payload: {\n        \"濕度\": Math.floor(Math.random() * 26 + 50)\n    }\n};\n\nreturn [[tempMsg, humMsg]];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 140,
        "wires": [
            [
                "fb78987c50152d9c"
            ]
        ]
    },
