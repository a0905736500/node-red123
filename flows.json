    {
        "id": "func_format_status_14",
        "type": "function",
        "z": "tab_project_b_14_zh",
        "name": "轉換中文狀態顯示",
        "func": "let data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch (e) {}\n}\n\nif (typeof data === 'object' && data !== null) {\n    let state = data[\"狀態\"] ?? data.power ?? \"關閉\";\n    let isOn = (state === \"開啟\" || String(state).toUpperCase() === \"ON\");\n    let bri = data[\"亮度\"] ?? data.brightness ?? (isOn ? 100 : 0);\n    msg.payload = isOn ? `💡 狀態：開啟 ｜ 亮度：${bri}%` : `🌑 狀態：關閉 ｜ 亮度：0%`;\n} else {\n    msg.payload = `目前狀態：${data}`;\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 440,
        "y": 240,
        "wires": [
