    {
        "id": "func_a_cmd_14",
        "type": "function",
        "z": "tab_project_b_14_zh",
        "name": "A組：整合控制指令(中文)",
        "func": "let power = flow.get('a_power') || '開啟';\nlet brightness = flow.get('a_brightness') ?? 80;\n\nif (msg.payload === 'ON' || msg.payload === 'OFF') {\n    power = (msg.payload === 'ON') ? '開啟' : '關閉';\n    if (power === '開啟' && brightness === 0) brightness = 50;\n} else if (typeof msg.payload === 'number') {\n    brightness = msg.payload;\n    power = brightness > 0 ? '開啟' : '關閉';\n}\n\nflow.set('a_power', power);\nflow.set('a_brightness', brightness);\n\nmsg.topic = \"AIOT/user14/control/led\";\nmsg.payload = {\n    \"電源\": power,\n    \"亮度\": brightness\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 450,
        "y": 130,
        "wires": [
            [
                "mqtt_out_a_ctrl_14"
            ]
