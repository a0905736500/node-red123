    {
        "id": "350786ae82281311",
        "type": "mqtt in",
        "z": "2889e6814487a261",
        "name": "訂閱所有組別感測器",
        "topic": "AIOT/#",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "ebbf3de0f7164c6d",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 210,
