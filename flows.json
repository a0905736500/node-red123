    {
        "id": "func_b_exec_14",
        "type": "function",
        "z": "tab_project_b_14_zh",
        "name": "B組：模擬執行並回傳中文",
        "func": "let data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch (e) {}\n}\n\nlet power = \"關閉\";\nlet brightness = 0;\n\nif (typeof data === 'object' && data !== null) {\n    let rawPower = String(data[\"電源\"] ?? data.power ?? \"關閉\").toUpperCase();\n    let isOn = (rawPower === \"開啟\" || rawPower === \"ON\" || rawPower === \"1\" || rawPower === \"TRUE\");\n    power = isOn ? \"開啟\" : \"關閉\";\n    brightness = Number(data[\"亮度\"] ?? data.brightness ?? (isOn ? 100 : 0));\n} else if (typeof data === 'number') {\n    brightness = data;\n    power = brightness > 0 ? \"開啟\" : \"關閉\";\n}\n\nif (power === \"關閉\") brightness = 0;\n\nnode.status({\n    fill: power === \"開啟\" ? \"yellow\" : \"grey\",\n    shape: \"dot\",\n    text: `電源: ${power} ｜ 亮度: ${brightness}%`\n});\n\nmsg.topic = \"AIOT/user14/status/led\";\nmsg.payload = {\n    \"狀態\": power,\n    \"亮度\": brightness\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 450,
        "y": 380,
        "wires": [
            [
                "mqtt_out_b_status_14"
            ]
