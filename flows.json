        "type": "inject",
        "z": "2889e6814487a261",
        "name": "模擬溫濕度 (每20秒)",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "20",
        "crontab": "",
